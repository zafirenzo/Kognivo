# Copy to .env.local for development. In production these live in Vercel environment variables, never in code.

NEXT_PUBLIC_SITE_URL=https://kognivo.com

# Supabase: Kognivo's own project. Service role is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. Use rzp_test_ keys until the first real sale.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend: receipts to buyers, and commission enquiries to the studio.
RESEND_API_KEY=
EMAIL_FROM="Kognivo <hello@kognivo.com>"
STUDIO_INBOX=hello@kognivo.com
